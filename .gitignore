# Build output of qmake/make. The folders are anchored to the project root ("/"),
# so that source folders of the same name further down (e.g. engines/texel/lib/,
# website/site/builds/) stay in git.
/build*/
/bin/
/lib/
*.o
*.obj
*.a
*.lib
*.exe
*.qm
moc_*
qrc_*
ui_*.h
Makefile*
.qmake.stash
*.pro.user*
*.autosave
# Engines: keep the upstream Makefiles, ignore downloaded networks
!engines/**/Makefile*
engines/viridithas/viridithas.nnue.zst
engines/viridithas/viridithas.nnue.zst.part
# Installer output (built, not versioned)
install/build/
install/output/
# OS
.DS_Store
Thumbs.db
